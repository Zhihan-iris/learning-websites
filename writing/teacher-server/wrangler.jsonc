{
  "name": "zhihan-writing-teacher",
  "main": "worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://zhihan-iris.github.io",
    "MAX_DAILY_REQUESTS": "40",
    "ALLOW_PAID_MODELS": "false",
    "OPENROUTER_MODELS": "google/gemma-4-31b-it:free,openrouter/free,minimax/minimax-m3.1-flash:free",
    "OPENAI_MODELS": "",
    "DEEPSEEK_MODELS": "",
    "QWEN_MODELS": "",
    "QWEN_REGION": "beijing",
    "ANTHROPIC_MODELS": "",
    "CLOUDFLARE_MODELS": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "CLOUDFLARE_FREE_PLAN_CONFIRMED": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TEACHER_GATE",
        "class_name": "TeacherGate"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TeacherGate"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
